    {
      "id": "governed-task-from-chat",
      "title": "Prepare and run governed work from this task",
      "trigger_class": "governed_run_request",
      "when": "Start governed work from a plain request or tickets in any format, including work Codex judges worth splitting or independently verifying; read, steer, revise or stop an existing governed run.",
      "prerequisites": [
        "The project is enrolled for governed runs with its own checks and standing authority.",
        "Two different models passed onboarding, including the model named for the governed task.",
        "For new work, Codex drafted the goal, lanes and checks and shows the returned summary before start. For existing work, use its run_id directly with read, steer, revise or stop; do not prepare or start again. Standing authority admits an in-limit plan."
      ],
      "entry": {
        "tool": "prepare_work_summary",
        "operation": null,
        "input_schema": "orch-dork/work-summary-input/v1"
      },
      "steps": [
        {
          "tool": "prepare_work_summary",
          "purpose": "Interpret arbitrary supplied text as a draft; the host selects ready disjoint tickets and freezes the summary. Show it before start; raw text is provenance, never the plan digest."
        },
        {
          "tool": "start_governed_run",
          "purpose": "Admit the frozen plan against the standing authority, then self-test governed mode and start the governed task with zero workers or one worker per lane, or ask with each exceeded limit named."
        },
        {
          "tool": "read_governed_run",
          "purpose": "Wait for the host-computed verdict and report it with its record location."
        },
        {
          "tool": "stop_governed_run",
          "purpose": "Stop the run at once when the user says stop; the verdict is Stopped by you."
        },
        {
          "tool": "steer_governed_run",
          "purpose": "Forward exact user steering from the requesting task without broadening the plan."
        },
        {
          "tool": "revise_governed_run",
          "purpose": "Answer a specific revision offer and re-admit a changed plan before activation."
        },
        {
          "tool": "propose_ticket_status_update",
          "purpose": "Only after Verified, propose exact status edits for the selected local tickets; ask the user to confirm the returned diff."
        },
        {
          "tool": "confirm_ticket_status_update",
          "purpose": "Only after explicit confirmation of that exact proposal, compare the file and apply the proposed status edits once."
        }
      ],
      "report_schemas": [
        "orch-dork/governed-run-start/v1",
        "orch-dork/governed-run-read/v1",
        "orch-dork/governed-run-stop-report/v1",
        "orch-dork/work-summary-report/v1",
        "orch-dork/ticket-status-proposal/v1",
        "orch-dork/ticket-status-update/v1",
        "orch-dork/governed-run-steer-report/v1",
        "orch-dork/governed-run-revise-report/v1"
      ],
      "evidence_boundary": "The plan binds to the admitted work summary, never raw input. Verified is the host verdict from its checks and hook/owner records. Status edits are proposed only after Verified and applied only after explicit confirmation of the exact diff in the requesting task; standing run authority supplies no status-write confirmation. Changed or revised summaries, other tasks, stale files and active runs refuse status write-back.",
      "terminal_statuses": [
        "TERMINAL",
        "APPLIED"
      ],
      "typed_stops": [
        "REFUSED"
      ],
