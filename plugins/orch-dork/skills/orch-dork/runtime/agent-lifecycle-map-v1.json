        },
        "REFUSED": {
          "disposition": "STOP"
        }
      }
    },
    "evaluate_orchestration_control_tower": {
      "status_paths": [
        "result.preparation_status",
        "result.decision_status",
        "status"
      ],
      "rules": {
        "READY_TO_FREEZE": {
          "disposition": "INVOKE",
          "next": {
            "tool": "evaluate_orchestration_control_tower",
            "operation": "advance",
            "input_schema": "orch-dork/control-tower-program/v1"
          }
        },
        "PLANNING_REQUIRED": {
          "disposition": "AWAIT_DECISION"
        },
        "REFUSED": {
          "disposition": "STOP"
        },
        "ADVANCED": {
          "disposition": "AWAIT_EVIDENCE"
        },
        "QUEUED": {
          "disposition": "AWAIT_EVIDENCE"
